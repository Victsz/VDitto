  "save_markdown_01_normal": {
    "description": "Save text to new file in existing dir",
    "input": {
      "text": "Hello world",
      "name": "test-note",
      "save_dir_env": "temp_dir"
    },
    "expected_output": {
      "should_reject": false,
      "reason": "",
      "result": {
        "file_content": "Hello world",
        "filename": "test-note.md"
      }
    }
  },
  "save_markdown_02_create_dir": {
    "description": "save_dir doesn't exist → auto-create and save",
