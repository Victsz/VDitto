  "make_filename_01_auto": {
    "description": "None → yyyymmdd-hhmmss.md format",
    "input": {
      "name": null
    },
    "expected_output": {
      "should_reject": false,
      "reason": "",
      "result": {
        "matches_pattern": "^\\d{8}-\\d{6}\\.md$"
      }
    }
  },
