{
  "detect_macro_01_save_no_name": {
    "description": "{{SAVE}} at start of text → filename=None, macro line removed",
    "input": {
      "text": "{{SAVE}}\nHello world\nThis is content"
    },
    "expected_output": {
      "should_reject": false,
      "reason": "",
      "result": {
        "name": null,
        "clean_text": "Hello world\nThis is content"
      }
    }
  },
  "detect_macro_02_save_with_name": {
    "description": "{{SAVE:meeting-notes}} → filename='meeting-notes'",
    "input": {
      "text": "{{SAVE:meeting-notes}}\nMeeting content here"
    },
    "expected_output": {
      "should_reject": false,
      "reason": "",
      "result": {
        "name": "meeting-notes",
        "clean_text": "Meeting content here"
      }
    }
  },
  "detect_macro_03_no_macro": {
    "description": "No macro in text → (None, original text)",
