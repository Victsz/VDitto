  "split_text_01_short": {
    "description": "Text <= max_len → single chunk",
    "input": {
      "text": "Hello",
      "max_len": 10
    },
    "expected_output": {
      "result": {
        "chunks": ["Hello"]
      }
    }
  },
  "split_text_02_at_boundary": {
    "description": "Text exactly max_len → single chunk",
    "input": {
      "text": "1234567890",
      "max_len": 10
    },
    "expected_output": {
      "result": {
        "chunks": ["1234567890"]
      }
    }
  },
  "split_text_03_split_at_newline": {
    "description": "Text > max_len with newlines → split at newline boundary",
    "input": {
      "text": "aaa\nbbb\nccc",
      "max_len": 8
    },
    "expected_output": {
      "result": {
        "chunks": ["aaa\nbbb\n", "ccc"]
      }
    }
  },
  "split_text_04_hard_cut_no_newline": {
    "description": "Text > max_len without newlines → hard cut",
    "input": {
      "text": "abcdefghij",
      "max_len": 5
    },
    "expected_output": {
      "result": {
        "chunks": ["abcde", "fghij"]
      }
    }
  },
  "split_text_05_multiple_splits": {
    "description": "Long text → multiple chunks at newline boundaries",
    "input": {
      "text": "aaa\nbbb\nccc\nddd\neee",
      "max_len": 8
    },
    "expected_output": {
      "result": {
        "chunk_count": 3
      }
    }
  },
  "split_text_06_empty": {
    "description": "Empty text → single empty chunk",
    "input": {
      "text": "",
      "max_len": 10
    },
    "expected_output": {
      "result": {
        "chunks": [""]
      }
    }
  }
