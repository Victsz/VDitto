    "input": {
      "text": "{{SAVE}}\nHello world\nThis is content"
    },
    "expected_output": {
      "should_reject": false,
      "reason": "",
      "result": {
        "mode": "A",
        "name": null,
        "clean_text": "Hello world\nThis is content"
      }
    }
  },
